{
  "name": "ai-portfolio-template",
  "version": "1.0.0",
  "private": true,
  "description": "A configurable personal portfolio built with Next.js, with an optional AI assistant that answers visitors' questions from the site content.",
  "license": "MIT",
  "author": "Guilherme Balduino Lopes (https://mikin.ai)",
  "homepage": "https://github.com/GuilhermeMikin/ai-portfolio-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuilhermeMikin/ai-portfolio-template.git"
  },
  "bugs": {
    "url": "https://github.com/GuilhermeMikin/ai-portfolio-template/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/check-content.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/check-content.ts",
    "tailwind:check": "tsx scripts/check-tailwind-classes.ts",
    "eval": "tsx scripts/eval/run.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.475.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
