{
  "name": "ai-portfolio-template",
  "version": "0.1.0",
  "private": true,
  "description": "A configurable personal portfolio built with Next.js, with an optional AI assistant that answers questions using only the site content.",
  "license": "MIT",
  "author": "Guilherme Balduino Lopes (https://mikin.ai)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx scripts/check-content.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/check-content.ts",
    "tailwind:check": "tsx scripts/check-tailwind-classes.ts",
    "eval": "tsx scripts/eval/run.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.475.0",
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
