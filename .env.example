# Environment variables for this portfolio.
#
# Local development: copy this file to .env.local (git-ignored) and fill in what you need.
# Production: set the same variables in your hosting provider's dashboard.
# Every variable is optional. With none set the site works and the AI chat is off.
#
# PUBLIC       NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
#              Anyone can read them, so never put a secret in one.
# SERVER-ONLY  read on the server only, never sent to the browser.
# SECRET       a server-only credential: keep it out of git, logs and screenshots.
# Next.js reads .env.local (and .env) at startup: restart `pnpm dev` after editing.
# A value that cannot be parsed (e.g. "12abc" for a number) is ignored: the default is used
# and the server logs one warning naming the variable (never its value).

# ------------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------------
# PUBLIC. Canonical origin for links, Open Graph and the sitemap, e.g. https://example.com.
# Empty: Vercel's production URL when deployed there, otherwise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------------------------
# Chat mode & model
# ------------------------------------------------------------------------------
# CHAT_MODE decides what the AI assistant does:
#   live    real answers from the model configured below (needs LLM_API_KEY)
#   demo    simulated replies built from the site content, clearly labeled; no model calls, no cost
#   off     no assistant; the rest of the site works normally
#   empty   live when LLM_API_KEY is set, otherwise off
# Any other value turns the assistant off (and logs a warning).
# A production live chat also needs Upstash (see below) unless CHAT_RATE_LIMIT_STORE=memory.
# Pages are prerendered, so the interface fixes the mode at build time: rebuild or redeploy after
# changing CHAT_MODE or LLM_API_KEY. Building without secrets (e.g. a Docker image)? Build with
# CHAT_MODE=live and provide the key at runtime; the API checks it on every request.

# SERVER-ONLY. live | demo | off, or empty for the automatic choice above.
CHAT_MODE=
# SECRET. API key for the OpenAI Chat Completions API, or a provider that implements it (see README).
LLM_API_KEY=
# SERVER-ONLY. Base URL of that API, e.g. https://openrouter.ai/api/v1 for OpenRouter.
LLM_BASE_URL=https://api.openai.com/v1
# SERVER-ONLY. Model id sent to the API. Models and prices change: pick one from your provider's list.
CHAT_MODEL=gpt-4o-mini
# SERVER-ONLY. Sampling temperature (0–2); lower values give more literal answers. Empty uses 0.3.
# `default` leaves it out of the request: some reasoning models (e.g. OpenAI's o-series and
# GPT-5 family) reject any temperature.
CHAT_TEMPERATURE=0.3
# SERVER-ONLY. Max tokens per answer (16–4000); also bounds the cost of each reply.
# Reasoning models count their hidden reasoning in this limit too: raise it for them.
CHAT_MAX_TOKENS=700
# SERVER-ONLY. Name of that limit in the request: max_tokens (most providers) or
# max_completion_tokens (required by newer OpenAI models, which reject max_tokens).
CHAT_MAX_TOKENS_PARAM=max_tokens
# SERVER-ONLY. Timeout for one model request, in milliseconds (1000–27000). The chat route
# may run for 30 seconds, so higher values are capped at 27000 to leave time to report it.
CHAT_REQUEST_TIMEOUT_MS=25000
# SERVER-ONLY. client = the browser sends earlier turns for follow-up questions; off = every question stands alone
# (the per-conversation limit below still applies).
CHAT_HISTORY_MODE=client
# SERVER-ONLY. Messages (visitor + assistant) in one conversation before the visitor must start a new one.
CHAT_MAX_TRANSCRIPT_MESSAGES=20
# SERVER-ONLY. true renders basic Markdown (bold, lists, links) in answers; false shows plain text
# and asks the model (and the demo replies) for plain text.
CHAT_MARKDOWN_ENABLED=true
# SERVER-ONLY. Optional, OpenRouter only: your site URL and name for OpenRouter's app rankings.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# ------------------------------------------------------------------------------
# Rate limits & cost protection
# ------------------------------------------------------------------------------
# These limits slow down abuse, but they do NOT guarantee a spending cap. Always set a
# hard monthly budget or usage limit in your LLM provider's dashboard as well.
#
# The per-minute and per-conversation limits count every chat request. The token budget and
# both daily limits count model requests only: demo replies and the fixed "I can't do that"
# reply never call the model, so they never use them up. A request that is turned away by
# any limit uses up none of them.
#
# CHAT_RATE_LIMIT_STORE picks where the counters live:
#   upstash  a shared Redis database (see Upstash below): one limit for every server instance
#   memory   counters inside each server process. Fine for local development and demo mode,
#            but on serverless or multi-instance hosting every instance counts on its own, so
#            it is NOT a global limit. Use Upstash for a public site with the live chat.
#   empty    Upstash when it is configured, otherwise memory outside production. In production,
#            the live chat stays off without Upstash unless you choose memory explicitly.

# SERVER-ONLY. upstash | memory, or empty for the automatic choice above.
CHAT_RATE_LIMIT_STORE=
# SERVER-ONLY. Name of a header your proxy or CDN sets to the visitor's IP address, e.g.
# cf-connecting-ip (Cloudflare), fly-client-ip (Fly.io), x-real-ip (an nginx you configured)
# or x-vercel-forwarded-for (Vercel). When set, only that header identifies visitors, and
# requests without it share one bucket. Never name a header that visitors can set themselves.
# Empty: the first X-Forwarded-For entry, then X-Real-IP. Vercel overwrites X-Forwarded-For,
# but proxies that append to it leave the first entry under the visitor's control, so per-IP
# limits can be dodged there; the site-wide daily limit still holds.
# IPv6 visitors are limited per /64 network.
RATE_LIMIT_IP_HEADER=
# SERVER-ONLY. Chat requests per visitor IP per minute.
RATE_LIMIT_RPM=10
# SERVER-ONLY. Messages per conversation within the window below.
CHAT_CONVERSATION_QUOTA_LIMIT=12
# SERVER-ONLY. Length of that conversation window, in seconds.
CHAT_CONVERSATION_QUOTA_WINDOW_SECONDS=600
# SERVER-ONLY. Estimated tokens (prompt + answer) of model requests per visitor IP per minute; 0 turns it off.
CHAT_SOFT_TOKEN_BUDGET_PER_MINUTE=32000
# SERVER-ONLY. Model requests per visitor IP per UTC day; 0 turns it off. Keeps one visitor
# from using up the site-wide limit below.
CHAT_IP_DAILY_REQUEST_LIMIT=50
# SERVER-ONLY. Model requests per UTC day for the whole site (all visitors together); 0 turns it off.
# It caps the number of requests, not money: the cost of each one depends on the model and the answer length.
CHAT_DAILY_REQUEST_LIMIT=300

# ------------------------------------------------------------------------------
# Upstash Redis (shared rate-limit store)
# ------------------------------------------------------------------------------
# Recommended for any public deployment with the live chat. Create a Redis database at
# upstash.com and copy its REST URL and token. Every chat request runs a few Redis commands:
# check the plan's request and bandwidth limits against your expected traffic.

# SERVER-ONLY. REST URL of the database (https://<your-database>.upstash.io).
UPSTASH_REDIS_REST_URL=
# SECRET. REST token of the database.
UPSTASH_REDIS_REST_TOKEN=
# SERVER-ONLY. Prefix for every rate-limit key, so several sites can share one database.
RATE_LIMIT_KEY_PREFIX=portfolio

# ------------------------------------------------------------------------------
# Contact form (optional, sent with Resend)
# ------------------------------------------------------------------------------
# Without RESEND_API_KEY and RESEND_TO_EMAIL the contact page shows only the email
# address and social links from your profile, without a form.

# SECRET. Resend API key (resend.com).
RESEND_API_KEY=
# SERVER-ONLY. Inbox that receives the messages, e.g. you@example.com. Never shown to visitors.
RESEND_TO_EMAIL=
# SERVER-ONLY. Sender. Empty uses Resend's test sender "Portfolio <onboarding@resend.dev>",
# which only delivers to your own Resend account address; use a domain you verified in Resend.
RESEND_FROM_EMAIL=
# SERVER-ONLY. Messages per visitor IP within the window below (only valid messages count).
CONTACT_RATE_LIMIT_MAX=5
# SERVER-ONLY. Length of that window, in seconds.
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------------------------------------------------------
# Analytics
# ------------------------------------------------------------------------------
# SERVER-ONLY (not secret). true adds Vercel Web Analytics; also enable it in the Vercel dashboard.
ENABLE_VERCEL_ANALYTICS=false

# ------------------------------------------------------------------------------
# Local development
# ------------------------------------------------------------------------------
# `next dev` only. Comma-separated hostnames or IPs (no scheme or port) allowed to open the
# dev server from another device on your network. No effect on production builds.
DEV_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Evals
# ------------------------------------------------------------------------------
# `pnpm eval` only, never read by the site: the running site that scripts/eval/run.ts questions.
# The eval sends real model requests and costs tokens (see `pnpm eval --help`).
CHAT_EVAL_BASE_URL=http://127.0.0.1:3000
